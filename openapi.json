        "/api/k8s/istio/{type}": {
            "get": {
                "tags": [
                    "Kubernetes Diagnostics"
                ],
                "summary": "Istio-Ressourcen auflisten",
                "description": "Listet spezifische Istio-Ressourcen eines Namespaces auf. Unterstützte Typen: `virtualservices`, `destinationrules`.",
                "operationId": "getIstioResources",
                "parameters": [
                    {
                        "name": "type",
                        "in": "path",
                        "description": "Istio-Ressourcentyp",
                        "required": true,
                        "schema": {
                            "type": "string"
                        },
                        "example": "virtualservices"
                    },
                    {
                        "name": "namespace",
                        "in": "query",
                        "description": "Kubernetes-Namespace",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "default": "default"
                        },
                        "example": "default"
