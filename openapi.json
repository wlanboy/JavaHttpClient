{
    "openapi": "3.1.0",
    "info": {
        "title": "OpenAPI definition",
        "version": "v0"
    },
    "servers": [
        {
            "url": "http://localhost:8080",
            "description": "Generated server url"
        }
    ],
    "tags": [
        {
            "name": "HTTP Client",
            "description": "Sendet HTTP-Anfragen an beliebige Ziel-URLs weiter"
        },
        {
            "name": "Kubernetes Diagnostics",
            "description": "Diagnoseinformationen zu Kubernetes-Kontext und Istio-Sidecar"
        }
    ],
    "paths": {
        "/client": {
            "post": {
                "tags": [
                    "HTTP Client"
                ],
                "summary": "HTTP-Request weiterleiten",
                "description": "Sendet einen HTTP-Request mit der angegebenen Methode, URL und optionalem Body an das Ziel-System",
                "operationId": "postMapping",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/JavaHttpRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "Antwort des Zielsystems",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Ungültige Anfrage (Validierungsfehler)"
                    },
                    "502": {
                        "description": "Fehler beim Verbinden mit dem Zielsystem"
                    }
                }
            }
        },
        "/api/k8s/tls": {
            "get": {
                "tags": [
                    "Kubernetes Diagnostics"
                ],
                "summary": "TLS-Zertifikat inspizieren",
                "description": "Baut eine separate TLS-Verbindung zum Ziel auf und gibt Protokoll, Cipher Suite, Zertifikatskette und SPIFFE/mTLS-Informationen zurück.",
                "operationId": "inspectTls",
                "parameters": [
                    {
                        "name": "url",
                        "in": "query",
                        "description": "Ziel-URL (muss https:// sein)",
                        "required": true,
                        "schema": {
                            "type": "string"
                        },
                        "example": "https://example.com"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "TLS-Informationen erfolgreich abgerufen",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/TlsInspection"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/k8s/status": {
            "get": {
                "tags": [
                    "Kubernetes Diagnostics"
                ],
                "summary": "K8s-Client-Status abrufen",
                "description": "Zeigt ob der Kubernetes API Client erfolgreich initialisiert wurde, und listet die unterstützten Istio-Ressourcentypen und API-Versionen.",
                "operationId": "getK8sStatus",
                "responses": {
                    "200": {
                        "description": "K8s-Clientstatus",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/K8sStatus"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/k8s/services": {
            "get": {
                "tags": [
                    "Kubernetes Diagnostics"
                ],
                "summary": "Über Envoy erreichbare Services auflisten",
                "description": "Parst die Envoy Admin API (/clusters) und liefert alle über den Sidecar erreichbaren Outbound-Services mit Host und Port, z.B. für ein Service-Auswahl-Dropdown.",
                "operationId": "getReachableServices",
                "responses": {
                    "200": {
                        "description": "Liste der über Envoy erreichbaren Services",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/ReachableService"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/k8s/istio/{type}": {
            "get": {
                "tags": [
                    "Kubernetes Diagnostics"
                ],
                "summary": "Istio-Ressourcen auflisten",
                "description": "Listet spezifische Istio-Ressourcen eines Namespaces auf. Unterstützte Typen: `virtualservices`, `destinationrules`, `gateways`, `serviceentries`, `sidecars`, `envoyfilters`, `peerauthentications`, `requestauthentications`, `authorizationpolicies`.",
                "operationId": "getIstioResources",
                "parameters": [
                    {
                        "name": "type",
                        "in": "path",
                        "description": "Istio-Ressourcentyp",
                        "required": true,
                        "schema": {
                            "type": "string"
                        },
                        "example": "virtualservices"
                    },
                    {
                        "name": "namespace",
                        "in": "query",
                        "description": "Kubernetes-Namespace",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "default": "default"
                        },
                        "example": "default"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Liste der Istio-Ressourcen",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "type": "object"
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Ungültiger Ressourcentyp",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/k8s/istio/full-report": {
            "get": {
                "tags": [
                    "Kubernetes Diagnostics"
                ],
                "summary": "Vollständigen Istio-Report abrufen",
                "description": "Holt alle Envoy-Konfigurationen und Fehlerstatistiken des Istio-Sidecars. Im Fehlerfall wird 200 mit Fehlerbeschreibung im Body zurückgegeben.",
                "operationId": "getFullReport",
                "responses": {
                    "200": {
                        "description": "Report generiert (enthält ggf. Fehlerbeschreibung im Body)",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/SidecarReport"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/k8s/correlate": {
            "get": {
                "tags": [
                    "Kubernetes Diagnostics"
                ],
                "summary": "URL mit Istio-Config korrelieren",
                "description": "Prüft ob die angegebene URL durch VirtualService/DestinationRule/ServiceEntry abgedeckt ist und ob AuthorizationPolicy/PeerAuthentication/Sidecar-Egress den Zugriff erlauben. Der Ziel-Namespace wird automatisch aus dem FQDN-Host abgeleitet (service.namespace.svc.cluster.local) und zusätzlich zum übergebenen Source-Namespace abgefragt.",
                "operationId": "correlateUrl",
                "parameters": [
                    {
                        "name": "url",
                        "in": "query",
                        "description": "Ziel-URL",
                        "required": true,
                        "schema": {
                            "type": "string"
                        },
                        "example": "http://my-service.default.svc.cluster.local/api/v1"
                    },
                    {
                        "name": "namespace",
                        "in": "query",
                        "description": "Source-Namespace (Namespace des Aufrufers)",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "default": "default"
                        },
                        "example": "default"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Korrelationsergebnis erfolgreich abgerufen",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/UrlCorrelation"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/k8s/context": {
            "get": {
                "tags": [
                    "Kubernetes Diagnostics"
                ],
                "summary": "K8s-Kontext abrufen",
                "description": "Liefert Namespace, Pod-Name und Istio-Sidecar-Status. Wird typischerweise beim Laden der Navbar verwendet.",
                "operationId": "getContext",
                "responses": {
                    "200": {
                        "description": "K8s-Kontextdaten erfolgreich abgerufen",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/K8sContext"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "HttpMethod": {},
            "JavaHttpRequest": {
                "type": "object",
                "properties": {
                    "url": {
                        "type": "string",
                        "description": "Die Ziel-URL",
                        "example": "https://github.com",
                        "minLength": 1,
                        "pattern": "^https?://.*"
                    },
                    "method": {
                        "$ref": "#/components/schemas/HttpMethod",
                        "description": "HTTP Methode",
                        "enum": [
                            "GET",
                            "POST",
                            "PUT",
                            "DELETE",
                            "PATCH",
                            "HEAD",
                            "OPTIONS"
                        ],
                        "example": "POST"
                    },
                    "body": {
                        "type": "string",
                        "description": "Optionaler Request Body",
                        "example": {
                            "key": "value"
                        }
                    },
                    "contentType": {
                        "type": "string",
                        "description": "Content-Type des Bodys",
                        "example": "application/json"
                    },
                    "copyHeaders": {
                        "type": "boolean",
                        "description": "Header kopieren"
                    },
                    "customHeaders": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "string"
                        },
                        "description": "Header hinzufuegen"
                    }
                },
                "required": [
                    "method",
                    "url"
                ]
            },
            "CertificateInfo": {
                "type": "object",
                "description": "Zertifikat aus der Server-Chain",
                "properties": {
                    "index": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "type": {
                        "type": "string",
                        "enum": [
                            "leaf",
                            "intermediate",
                            "root"
                        ]
                    },
                    "subject": {
                        "type": "string"
                    },
                    "issuer": {
                        "type": "string"
                    },
                    "serial": {
                        "type": "string"
                    },
                    "validFrom": {
                        "type": "string"
                    },
                    "validTo": {
                        "type": "string"
                    },
                    "daysUntilExpiry": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "expired": {
                        "type": "boolean"
                    },
                    "subjectAltNames": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                }
            },
            "TlsInspection": {
                "type": "object",
                "description": "Ergebnis der TLS-Inspektion",
                "properties": {
                    "host": {
                        "type": "string"
                    },
                    "port": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "tlsVersion": {
                        "type": "string"
                    },
                    "cipherSuite": {
                        "type": "string"
                    },
                    "isMtls": {
                        "type": "boolean"
                    },
                    "spiffeId": {
                        "type": "string",
                        "description": "Nur gesetzt bei SPIFFE-Zertifikat (Istio mTLS)"
                    },
                    "chain": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/CertificateInfo"
                        }
                    },
                    "error": {
                        "type": "string"
                    }
                }
            },
            "K8sStatus": {
                "type": "object",
                "description": "Initialisierungsstatus des Kubernetes API Clients",
                "properties": {
                    "initialized": {
                        "type": "boolean"
                    },
                    "supportedIstioTypes": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "uniqueItems": true
                    },
                    "istioVersionsProbed": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "initError": {
                        "type": "string",
                        "description": "Nur gesetzt, wenn die Initialisierung fehlgeschlagen ist"
                    }
                }
            },
            "ReachableService": {
                "type": "object",
                "description": "Über den Envoy-Sidecar erreichbarer Outbound-Service",
                "properties": {
                    "host": {
                        "type": "string",
                        "example": "my-service.default.svc.cluster.local"
                    },
                    "port": {
                        "type": "integer",
                        "format": "int32",
                        "example": 8080
                    },
                    "shortName": {
                        "type": "string",
                        "example": "my-service"
                    },
                    "subset": {
                        "type": "string",
                        "description": "Nur gesetzt, wenn der Cluster ein Subset hat"
                    }
                }
            },
            "ErrorResponse": {
                "type": "object",
                "description": "Fehlerantwort",
                "properties": {
                    "error": {
                        "type": "string"
                    }
                }
            },
            "Diagnosis": {
                "type": "object",
                "description": "Aus Envoy-Fehlermetriken abgeleitete Diagnose",
                "properties": {
                    "severity": {
                        "type": "string",
                        "enum": [
                            "KRITISCH",
                            "WARNUNG",
                            "INFO"
                        ]
                    },
                    "title": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "recommendation": {
                        "type": "string"
                    },
                    "affectedMetrics": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                }
            },
            "HealthDiagnostics": {
                "type": "object",
                "description": "Sektion B: Gesundheit & Fehler",
                "properties": {
                    "activeErrorMetrics": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "string"
                        }
                    },
                    "errorCount": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "diagnoses": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Diagnosis"
                        }
                    }
                }
            },
            "Reachability": {
                "type": "object",
                "description": "Sektion A: Erreichbarkeit",
                "properties": {
                    "envoyConfig": {
                        "description": "Geparster Envoy /config_dump oder ConfigDumpTruncated, wenn das Größenlimit überschritten ist"
                    },
                    "activeEndpoints": {
                        "type": "string",
                        "description": "Rohausgabe von /clusters"
                    },
                    "summary": {
                        "type": "string"
                    }
                }
            },
            "SidecarReport": {
                "type": "object",
                "description": "Vollständiger Istio-Sidecar-Report",
                "properties": {
                    "reachability": {
                        "$ref": "#/components/schemas/Reachability"
                    },
                    "healthDiagnostics": {
                        "$ref": "#/components/schemas/HealthDiagnostics"
                    },
                    "timestamp": {
                        "type": "string"
                    },
                    "error": {
                        "type": "string"
                    }
                }
            },
            "AuthorizationAnalysis": {
                "type": "object",
                "description": "Bewertung der AuthorizationPolicies im Ziel-Namespace",
                "properties": {
                    "matchingPolicies": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/PolicyMatch"
                        }
                    },
                    "verdict": {
                        "type": "string"
                    }
                }
            },
            "DestinationRuleMatch": {
                "type": "object",
                "description": "Analyse einer DestinationRule gegen den Host",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "hostMatch": {
                        "type": "boolean"
                    },
                    "drHost": {
                        "type": "string"
                    },
                    "trafficPolicy": {
                        "description": "Rohdaten aus spec.trafficPolicy"
                    },
                    "subsets": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Subset"
                        }
                    },
                    "namespace": {
                        "type": "string"
                    }
                }
            },
            "HttpRouteAnalysis": {
                "type": "object",
                "description": "Analyse einer HTTP-Route eines VirtualService",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "pathMatch": {
                        "type": "boolean"
                    },
                    "matchReason": {
                        "type": "string"
                    },
                    "destinations": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/RouteDestination"
                        }
                    },
                    "timeout": {
                        "type": "string"
                    },
                    "retries": {
                        "description": "Rohdaten aus spec.http[].retries"
                    },
                    "faultInjection": {
                        "description": "Rohdaten aus spec.http[].fault"
                    }
                }
            },
            "PeerAuthenticationMatch": {
                "type": "object",
                "description": "PeerAuthentication, deren Selector auf den Ziel-Workload passt",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "mtlsMode": {
                        "type": "string"
                    }
                }
            },
            "PolicyMatch": {
                "type": "object",
                "description": "AuthorizationPolicy, deren Selector auf den Ziel-Workload passt",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "action": {
                        "type": "string"
                    },
                    "appliesToSource": {
                        "type": "boolean"
                    }
                }
            },
            "RouteDestination": {
                "type": "object",
                "description": "Routing-Ziel einer HTTP-Route",
                "properties": {
                    "host": {
                        "type": "string"
                    },
                    "subset": {
                        "type": "string"
                    },
                    "port": {
                        "description": "Rohdaten aus destination.port"
                    },
                    "weight": {
                        "type": "integer",
                        "format": "int32"
                    }
                }
            },
            "ServiceEntryMatch": {
                "type": "object",
                "description": "Analyse eines ServiceEntry gegen Host und Port",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "hostMatch": {
                        "type": "boolean"
                    },
                    "seHosts": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "location": {
                        "type": "string"
                    },
                    "resolution": {
                        "type": "string"
                    },
                    "ports": {
                        "description": "Rohdaten aus spec.ports"
                    },
                    "portMatch": {
                        "type": "boolean"
                    },
                    "portMatchWarning": {
                        "type": "string"
                    },
                    "endpoints": {
                        "description": "Rohdaten aus spec.endpoints"
                    },
                    "subjectAltNames": {
                        "description": "Rohdaten aus spec.subjectAltNames"
                    },
                    "namespace": {
                        "type": "string"
                    }
                }
            },
            "SidecarEgress": {
                "type": "object",
                "description": "Egress-Scoping durch Sidecar-Resources im Source-Namespace",
                "properties": {
                    "restricted": {
                        "type": "boolean"
                    },
                    "info": {
                        "type": "string"
                    },
                    "hostAllowed": {
                        "type": "boolean"
                    },
                    "checkedEgressHosts": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "warning": {
                        "type": "string"
                    }
                }
            },
            "Subset": {
                "type": "object",
                "description": "Subset einer DestinationRule",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "labels": {
                        "description": "Rohdaten aus subsets[].labels"
                    },
                    "trafficPolicy": {
                        "description": "Rohdaten aus subsets[].trafficPolicy"
                    }
                }
            },
            "UrlCorrelation": {
                "type": "object",
                "description": "Ergebnis der Korrelation einer URL mit der Istio-Konfiguration",
                "properties": {
                    "requestedHost": {
                        "type": "string"
                    },
                    "requestedPath": {
                        "type": "string"
                    },
                    "sourceNamespace": {
                        "type": "string"
                    },
                    "targetNamespace": {
                        "type": "string"
                    },
                    "queriedNamespaces": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "matchedVirtualServices": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/VirtualServiceMatch"
                        }
                    },
                    "matchedDestinationRules": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/DestinationRuleMatch"
                        }
                    },
                    "matchedServiceEntries": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/ServiceEntryMatch"
                        }
                    },
                    "authorizationPolicies": {
                        "$ref": "#/components/schemas/AuthorizationAnalysis"
                    },
                    "peerAuthentications": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/PeerAuthenticationMatch"
                        }
                    },
                    "sidecarEgress": {
                        "$ref": "#/components/schemas/SidecarEgress"
                    },
                    "hasMatch": {
                        "type": "boolean"
                    },
                    "error": {
                        "type": "string"
                    }
                }
            },
            "VirtualServiceMatch": {
                "type": "object",
                "description": "Analyse eines VirtualService gegen Host und Pfad",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "hostMatch": {
                        "type": "boolean"
                    },
                    "vsHosts": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "noHttpRoutes": {
                        "type": "boolean"
                    },
                    "httpRoutes": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/HttpRouteAnalysis"
                        }
                    },
                    "pathMatch": {
                        "type": "boolean"
                    },
                    "namespace": {
                        "type": "string"
                    }
                }
            },
            "EnvoyDetails": {
                "type": "object",
                "description": "Kurzinfo aus der Envoy Admin API",
                "properties": {
                    "info": {
                        "type": "object",
                        "additionalProperties": {},
                        "description": "Rohdaten von /server_info"
                    },
                    "clusterSummary": {
                        "type": "string"
                    },
                    "networkStats": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "string"
                        }
                    },
                    "error": {
                        "type": "string"
                    }
                }
            },
            "K8sContext": {
                "type": "object",
                "description": "Pod-Kontext für die Navbar",
                "properties": {
                    "podName": {
                        "type": "string"
                    },
                    "namespace": {
                        "type": "string"
                    },
                    "istioSidecar": {
                        "type": "boolean"
                    },
                    "istioDetails": {
                        "$ref": "#/components/schemas/EnvoyDetails",
                        "description": "Nur gesetzt, wenn ein Istio-Sidecar aktiv ist"
                    }
                }
            }
        }
    }
}